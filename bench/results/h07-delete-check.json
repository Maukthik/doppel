{
 "id": "h07-delete-check",
 "kind": "regression",
 "title": "Readability: early return in delete",
 "source": "planted",
 "bug": "Authors can't delete their posts, and anyone can delete everyone else's.",
 "expect": "DELETE /api/posts/",
 "set": "heldout",
 "tests": {
  "caught": true,
  "failed": [
   "tests/test_posts.py::PostTests::test_delete_post",
   "tests/test_posts.py::PostTests::test_permissions"
  ],
  "summary": "2 failed, 42 passed in 9.98s",
  "seconds": 10.5
 },
 "review": {
  "caught": true,
  "verdict": "regression",
  "why": "The PR inverts the authorization logic: it now aborts with 403 when the current user IS the post author, and allows deletion when the user is NOT the author. This reverses the intended access control, letting users delete others' posts while blocking them from deleting their own.",
  "usd": 0.02818,
  "seconds": 3.3
 },
 "doppel_guided": {
  "detected": true,
  "caught": true,
  "any_regression": true,
  "needs_human": 0,
  "findings": [
