    "kind": "status",
    "persona": "erin_dupdel",
    "request": "DELETE /api/posts/1",
    "detail": "status 403 -> 204",
    "label": "regression",
    "why": "The diff inverts the authorization check from '!=' to '==', causing the author to receive 403 instead of 204, which the PR description does not announce.",
    "on_target": true,
    "label_v1": "regression"
   },
   {
    "kind": "status",
    "persona": "probe s1: user_alice",
    "request": "DELETE /api/posts/151",
    "detail": "status 204 -> 403",
    "label": "regression",
    "why": "The inverted condition now blocks non-authors with 403 where they previously received 204, a behavior change not mentioned in the PR description.",
    "on_target": true,
    "label_v1": "regression"
   },
   {
    "kind": "status",
    "persona": "probe s1: user_alice",
    "request": "GET /api/posts/151",
    "detail": "status 404 -> 200",
