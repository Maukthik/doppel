+@users.route('/users/<int:id>/stats', methods=['GET'])
+@authenticate(token_auth)
+@other_responses({404: 'User not found'})
+def stats(id):
+    """Retrieve post and follow counts for a user"""
+    import sqlalchemy as sqla
+    user = db.session.get(User, id) or abort(404)
+
+    def count(q):
+        return db.session.scalar(sqla.select(sqla.func.count()).select_from(q.subquery()))
+
+    return {'posts': count(user.posts.select()), 'followers': count(user.followers.select()),
+            'following': count(user.following.select())}
+
+
 @users.route('/users/<int:id>/following', methods=['GET'])
