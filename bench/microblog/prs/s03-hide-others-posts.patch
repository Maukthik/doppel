diff --git a/api/posts.py b/api/posts.py
index 29645c6..2e47b70 100644
--- a/api/posts.py
+++ b/api/posts.py
@@ -68,7 +68,7 @@ def put(data, id):
     """Edit a post"""
     post = db.session.get(Post, id) or abort(404)
     if post.author != token_auth.current_user():
-        abort(403)
+        abort(404)
     post.update(data)
     db.session.commit()
     return post
@@ -81,7 +81,7 @@ def delete(id):
     """Delete a post"""
     post = db.session.get(Post, id) or abort(404)
     if post.author != token_auth.current_user():
-        abort(403)
+        abort(404)
     db.session.delete(post)
     db.session.commit()
     return '', 204
