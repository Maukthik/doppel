[
 {"name": "reader", "steps": [
   {"method": "GET", "path": "/snippets/"}, {"method": "GET", "path": "/snippets/1/"},
   {"method": "GET", "path": "/snippets/1/highlight/"}, {"method": "GET", "path": "/snippets/2/highlight/"}]},
 {"name": "user browser", "steps": [{"method": "GET", "path": "/users/"}, {"method": "GET", "path": "/users/1/"}]},
 {"name": "alice edits her own", "steps": [
   {"method": "PATCH", "path": "/snippets/1/", "auth": ["alice", "doppel-pass"], "json": {"code": "print(42)"}}]},
 {"name": "bob edits alice's", "steps": [
   {"method": "PATCH", "path": "/snippets/1/", "auth": ["bob", "doppel-pass"], "json": {"title": "mine now"}},
   {"method": "DELETE", "path": "/snippets/2/", "auth": ["bob", "doppel-pass"]}]},
 {"name": "new snippet", "steps": [
   {"method": "POST", "path": "/snippets/", "auth": ["bob", "doppel-pass"],
    "json": {"title": "fresh", "code": "a = 1\nb = 2", "linenos": false}, "save": {"new": "url"}},
   {"method": "GET", "path": "{new}highlight/"}]},
 {"name": "anonymous writer", "steps": [
   {"method": "POST", "path": "/snippets/", "json": {"code": "x"}}]}
]
