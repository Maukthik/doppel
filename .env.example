# Copy to .env and fill in. Never commit .env.
# Nebius Token Factory runs the sandboxes and the NVIDIA Nemotron models. The offline example
# (examples/shop with the local backend) needs neither.
NEBIUS_API_KEY=your-token-factory-key
NEBIUS_PROJECT_ID=your-project-id
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# The models that write users and judge changes (these are the defaults)
PERSONA_MODEL=nvidia/Nemotron-3_5-Lightning
JUDGE_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
