# Copy to .env and fill in. Never commit .env.
# Needed from stage 2 (Nebius sandboxes + Nemotron). Stage 1 runs fully offline.
NEBIUS_API_KEY=your-token-factory-key
NEBIUS_PROJECT_ID=your-project-id
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Nemotron roles (stage 2)
PERSONA_MODEL=nvidia/Nemotron-3_5-Lightning
JUDGE_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
